<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.nettriage</groupId>
    <artifactId>nettriage</artifactId>
    <version>0.1.0</version>
  </parent>
  <artifactId>agent</artifactId>
  <name>NetTriage agent</name>
  <description>Claude tool-use agent over the NetTriage tools, with a grounding verifier and an evaluation harness.</description>

  <dependencies>
    <dependency>
      <groupId>io.nettriage</groupId>
      <artifactId>triage-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.nettriage</groupId>
      <artifactId>bench</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>io.nettriage.agent.AgentEval</mainClass>
          <classifier>exec</classifier>
        </configuration>
        <executions>
          <execution>
            <goals><goal>repackage</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
